DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 구글 소셜 로그인 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
# 승인된 리디렉션 URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 카카오 소셜 로그인 (Kakao Developers > 내 애플리케이션 > 앱 키)
# Redirect URI: http://localhost:8000/accounts/kakao/login/callback/
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret